{
    "name": "@concertypin/config",
    "version": "0.5.0",
    "description": "Shared Oxlint and Oxfmt configuration presets for Templecon TypeScript templates <3",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "templecon",
        "url": "https://github.com/templecon"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/templecon/configs.git"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./oxlint": {
            "types": "./dist/oxlint/index.d.ts",
            "default": "./dist/oxlint/index.js"
        },
        "./oxlint/frontend": {
            "types": "./dist/oxlint/frontend.d.ts",
            "default": "./dist/oxlint/frontend.js"
        },
        "./oxfmt": {
            "types": "./dist/oxfmt/index.d.ts",
            "default": "./dist/oxfmt/index.js"
        },
        "./oxfmt/frontend": {
            "types": "./dist/oxfmt/frontend.d.ts",
            "default": "./dist/oxfmt/frontend.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "lint": "oxlint -c oxlint.config.ts .",
        "test": "pnpm run build && node --test tests/base.test.js",
        "pack:check": "pnpm run build && node tests/pack-check.ts"
    },
    "engines": {
        "node": ">=26"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^26.6.4",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "oxlint-tailwindcss": "1.14.0",
        "oxlint-tsgolint": "7.0.2003",
        "tailwindcss": "4.3.3",
        "tsdown": "^0.23.0",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "oxfmt": ">=0.62.0 <1",
        "oxlint": ">=1.87.0 <2",
        "oxlint-tsgolint": "7.0.2003"
    },
    "packageManager": "pnpm@12.9.1",
    "peerDependenciesMeta": {
        "oxlint-tsgolint": {
            "optional": true
        }
    }
}
