{
    "name": "@concertypin/config",
    "version": "0.3.0",
    "type": "module",
    "license": "MIT",
    "author": {
        "name": "templecon",
        "url": "https://github.com/templecon"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/templecon/configs.git"
    },
    "files": [
        "dist/",
        "README.md",
        "LICENSE"
    ],
    "exports": {
        "./oxlint": {
            "types": "./dist/oxlint/index.d.ts",
            "default": "./dist/oxlint/index.js"
        },
        "./oxlint/frontend": {
            "types": "./dist/oxlint/frontend.d.ts",
            "default": "./dist/oxlint/frontend.js"
        },
        "./oxfmt": {
            "types": "./dist/oxfmt/index.d.ts",
            "default": "./dist/oxfmt/index.js"
        }
    },
    "scripts": {
        "build": "tsdown",
        "lint": "oxlint -c oxlint.config.ts .",
        "test": "pnpm run build && node --test tests/base.test.js",
        "pack:check": "pnpm run build && node tests/pack-check.mjs"
    },
    "engines": {
        "node": ">=24.11.0"
    },
    "packageManager": "pnpm@10.17.1+sha512.17c560fca4867ae9473a3899ad84a88334914f379be46d455cbf92e5cf4b39d34985d452d2583baf19967fa76cb5c17bc9e245529d0b98745721aa7200ecaf7a",
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "oxfmt": "^0.62.0",
        "oxlint": "^1.76.0",
        "tsdown": "^0.22.14",
        "typescript": "^5.9.3"
    },
    "peerDependencies": {
        "oxfmt": ">=0.62.0 <1",
        "oxlint": ">=1.47.0 <2"
    }
}
