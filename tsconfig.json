{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "types": ["node"],
        "allowImportingTsExtensions": true
    },
    "include": ["src", "tests", "./*.ts"],
    "exclude": ["tests/invalid.typecheck.ts", "tests/fixtures"]
}
